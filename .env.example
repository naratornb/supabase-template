# Copy to .env, then replace every placeholder before starting containers.
POSTGRES_PASSWORD=change-me-before-production
JWT_SECRET=change-me-with-at-least-32-characters
ANON_KEY=replace-with-generated-anon-key
SERVICE_ROLE_KEY=replace-with-generated-service-role-key
SECRET_KEY_BASE=replace-with-generated-secret-key-base
VAULT_ENC_KEY=replace-with-32-character-hex-key
PG_META_CRYPTO_KEY=replace-with-generated-crypto-key
LOGFLARE_PUBLIC_ACCESS_TOKEN=replace-with-generated-public-token
LOGFLARE_PRIVATE_ACCESS_TOKEN=replace-with-generated-private-token
S3_PROTOCOL_ACCESS_KEY_ID=replace-with-generated-access-key
S3_PROTOCOL_ACCESS_KEY_SECRET=replace-with-generated-secret
DASHBOARD_USERNAME=supabase
DASHBOARD_PASSWORD=change-me-before-production

SUPABASE_PUBLIC_URL=http://localhost:8000
API_EXTERNAL_URL=http://localhost:8000/auth/v1
SITE_URL=http://localhost:3000
ADDITIONAL_REDIRECT_URLS=
CORS_ORIGIN=http://localhost:3000
NEXT_PUBLIC_API_URL=http://localhost:5001
POSTGRES_HOST=db
POSTGRES_DB=postgres
POSTGRES_PORT=5432
POOLER_PROXY_PORT_TRANSACTION=6543
POOLER_DEFAULT_POOL_SIZE=20
POOLER_MAX_CLIENT_CONN=100
POOLER_TENANT_ID=stub
POOLER_DB_POOL_SIZE=5
STUDIO_DEFAULT_ORGANIZATION=Default Organization
STUDIO_DEFAULT_PROJECT=Default Project
OPENAI_API_KEY=

JWT_KEYS=[]
JWT_JWKS={"keys":[]}
JWT_EXPIRY=3600
DISABLE_SIGNUP=false
ENABLE_EMAIL_SIGNUP=true
ENABLE_EMAIL_AUTOCONFIRM=false
ENABLE_ANONYMOUS_USERS=false
ENABLE_PHONE_SIGNUP=false
ENABLE_PHONE_AUTOCONFIRM=false
SMTP_ADMIN_EMAIL=admin@example.com
SMTP_HOST=supabase-mail
SMTP_PORT=2500
SMTP_USER=fake_mail_user
SMTP_PASS=fake_mail_password
SMTP_SENDER_NAME=fake_sender
MAILER_URLPATHS_CONFIRMATION=/auth/v1/verify
MAILER_URLPATHS_INVITE=/auth/v1/verify
MAILER_URLPATHS_RECOVERY=/auth/v1/verify
MAILER_URLPATHS_EMAIL_CHANGE=/auth/v1/verify

GLOBAL_S3_BUCKET=stub
REGION=stub
STORAGE_TENANT_ID=stub
FUNCTIONS_VERIFY_JWT=false
PGRST_DB_SCHEMAS=public,graphql_public
PGRST_DB_MAX_ROWS=1000
PGRST_DB_EXTRA_SEARCH_PATH=public
DOCKER_SOCKET_LOCATION=/var/run/docker.sock
KONG_HTTP_PORT=8000
KONG_HTTPS_PORT=8443
IMGPROXY_AUTO_WEBP=true
PROXY_DOMAIN=your-domain.example.com
CERTBOT_EMAIL=admin@example.com
